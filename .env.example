# Copy to .env and paste your values. Gitignored except this example.

# MariaDB Cloud Serverless (Prisma reads ./.env only — not .env.local)
DATABASE_URL=

# Better Auth signing secret (min 32 characters)
BETTER_AUTH_SECRET=

# Local dev: http://localhost:3000
BETTER_AUTH_URL=

# Resend API key (must start with re_)
RESEND_API_KEY=

# SureCart webhook HMAC secret (min 24 characters)
SURECART_WEBHOOK_SECRET=

# Cron Authorization bearer token (min 24 characters)
CRON_SECRET=

# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Verified Resend sender
MAIL_FROM=

# Optional — not validated by src/lib/env.ts
# VERCEL_TOKEN=
# USDA FoodData Central API key (DEMO_KEY works for low-volume dev imports)
# USDA_FDC_API_KEY=

# Feature flags (Phase 0). Omit to use defaults.
# LEGACY_SLOT_ENGINE=true
# BIOLOGICAL_OS_ENGINE=false

# Optional SureCart checkout URL for portal unlock links
# SURECART_CHECKOUT_URL=
