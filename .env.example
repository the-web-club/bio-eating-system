# MariaDB Cloud Serverless connection string (mysql://…)
DATABASE_URL=

# Better Auth signing secret (min 32 characters)
BETTER_AUTH_SECRET=

# Public base URL Better Auth uses for callbacks
BETTER_AUTH_URL=

# Resend API key (must start with re_)
RESEND_API_KEY=

# Shared secret for verifying SureCart webhook HMAC
SURECART_WEBHOOK_SECRET=

# Bearer token for Vercel cron Authorization header
CRON_SECRET=

# Public site origin used in links and redirects
NEXT_PUBLIC_APP_URL=

# From address for Resend (must be a verified sender)
MAIL_FROM=
