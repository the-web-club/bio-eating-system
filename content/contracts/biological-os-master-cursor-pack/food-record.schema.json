{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"food-record-v1",
  "type":"object",
  "required":["foodId","name","source","sourceVersion","devOnly","reviewStatus","servingBasis","nutrients"],
  "properties":{
    "foodId":{"type":"string"},
    "name":{"type":"string"},
    "aliases":{"type":"array","items":{"type":"string"}},
    "category":{"type":["string","null"]},
    "preparation":{"type":["string","null"]},
    "source":{"type":"string"},
    "sourceVersion":{"type":"string"},
    "sourceRecordId":{"type":["string","null"]},
    "license":{"type":["string","null"]},
    "attributionRequired":{"type":"boolean"},
    "devOnly":{"type":"boolean"},
    "reviewStatus":{"enum":["REVIEW_REQUIRED","APPROVED","REJECTED"]},
    "servingBasis":{
      "type":"object","required":["amount","unit"],
      "properties":{"amount":{"type":"number","exclusiveMinimum":0},"unit":{"type":"string"}}
    },
    "allergens":{"type":"array","items":{"type":"string"}},
    "dietTags":{"type":"array","items":{"type":"string"}},
    "nutrients":{
      "type":"array",
      "items":{
        "type":"object","required":["nutrientCode","amount","unit"],
        "properties":{
          "nutrientCode":{"type":"string"},
          "amount":{"type":"number"},
          "unit":{"type":"string"},
          "basis":{"type":["string","null"]},
          "sourceValueId":{"type":["string","null"]}
        }
      }
    }
  }
}